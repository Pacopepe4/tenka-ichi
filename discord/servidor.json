  ],
  "categorias": [
    {
      "nombre": "Info",
      "permisos": { "todos": { "denegar": ["SEND_MESSAGES", "CREATE_PUBLIC_THREADS"] }, "staff": { "permitir": ["SEND_MESSAGES"] } },
      "canales": [
        { "nombre": "normas", "tema": "Normas del servidor y de la liga." },
        { "nombre": "anuncios", "tema": "Anuncios de Gokudō." },
        { "nombre": "calendario", "tema": "Jornadas y horarios de la temporada." }
      ]
    },
    {
      "nombre": "Liga",
      "permisos": { "todos": { "denegar": ["SEND_MESSAGES", "CREATE_PUBLIC_THREADS"] }, "staff": { "permitir": ["SEND_MESSAGES"] } },
      "canales": [
        { "nombre": "resultados", "tema": "Resultados de cada partida." },
        { "nombre": "clasificacion", "tema": "Clasificación de la liga." },
        { "nombre": "tier-list", "tema": "La tier list del staff y las de los espectadores." },
        { "nombre": "fantasy", "tema": "Clasificación del fantasy." }
      ]
    },
    {
      "nombre": "Gachapón",
      "permisos": { "todos": { "denegar": ["SEND_MESSAGES", "CREATE_PUBLIC_THREADS"] }, "staff": { "permitir": ["SEND_MESSAGES"] } },
      "canales": [
        { "nombre": "colecciones", "tema": "Las colecciones de cartas que enseñáis desde la web." },
        { "nombre": "alineaciones", "tema": "Las alineaciones que enseñáis desde la web." }
      ]
    },
    {
      "nombre": "Familias",
      "familias": true,
