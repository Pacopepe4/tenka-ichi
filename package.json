{
  "name": "tenka-ichi-draft",
  "version": "0.1.0",
  "private": true,
  "description": "Draft en directo de TENKA ICHI: refleja DraftCore en un overlay para OBS y lleva el registro de picks y bans",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "ddragon": "node scripts/ddragon.js",
