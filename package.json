    "simular": "node scripts/simular.js",
    "test": "node --test test/*.test.js",
    "twitch-falso": "node scripts/twitch-falso.js",
    "kick-falso": "node scripts/kick-falso.js",
    "entrada-discord-falso": "node scripts/entrada-discord-falso.js",
    "sheets-falso": "node scripts/sheets-falso.js",
    "vista-previa": "node scripts/vista-previa.js",
    "prueba-directo": "node scripts/prueba-directo.js",
    "discord-aplicar": "node scripts/discord-aplicar.js",
    "discord-api-falso": "node scripts/discord-api-falso.js",
    "discord-tickets": "node scripts/discord-tickets.js",
    "discord-scrims": "node scripts/discord-tickets.js --panel scrims",
