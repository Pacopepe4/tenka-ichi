# ─────────────────────────────────────────────────────────────────────────────
# Variables de la web de Tenka Ichi en el server casero.
# El instalador copia este archivo a servidor/.env (que NO se sube a GitHub).
# Rellénalo copiando los valores de Render: dashboard.render.com → tenka-ichi → Environment.
# Formato: NOMBRE=valor, sin espacios alrededor del =. Si el valor lleva espacios o
# caracteres raros, ponlo entre comillas simples: NOMBRE='valor raro'.
# ─────────────────────────────────────────────────────────────────────────────

# ── Del server casero (no están en Render) ──
DOMINIO=gokudo.es
# Correo para avisos de Let's Encrypt (caducidad del certificado). Pon el tuyo.
CORREO_CERTIFICADO=
# Mantiene el comportamiento "de producción" que el código asocia a Render:
# temporada 3 del gachapon, importaciones activadas, sin /auth/prueba y SESION_SECRETO obligatorio.
RENDER=1
GACHA_TEMPORADA=3
TORNEO_URL_PUBLICA=https://gokudo.es

# ── Contexto de los bots (Postgres con pgvector, contenedor «db») ──
# Una clave cualquiera, solo letras y números. Para sacarla: openssl rand -hex 24
# Sin ella, «db» no arranca y los bots siguen como antes (por ramas de la ficha).
PG_CLAVE=
# !pregunta en los chats de Kick y Twitch: preguntas al día entre los dos (de fábrica, 100) y por persona (5)
# CHAT_TOPE_DIA=100
# CHAT_TOPE_PERSONA=5
# Para apagar el contexto sin tocar nada más: CONTEXTO=0

# ── Copia de Render (obligatorias) ──
PANEL_CLAVE=
SESION_SECRETO=
GOOGLE_SHEET_ID=
# El JSON de la cuenta de servicio, ENTERO y en UNA sola línea, entre comillas simples:
# GOOGLE_CREDENTIALS='{"type":"service_account", ... }'
GOOGLE_CREDENTIALS=

# ── Discord ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ALINEACION=
DISCORD_WEBHOOK_TIERLIST=
DISCORD_WEBHOOK_CLASIFICACION=
DISCORD_WEBHOOK_DIRECTO=
DISCORD_WEBHOOK_RESULTADOS=

# ── Twitch y Kick ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Crónicas del realizador ──
CRONICAS_CLAVE=

# ── Otras que el código usa y quizá tengas puestas en Render ──
# Copia también CUALQUIER otra variable que veas en Render y no esté aquí (salvo las que
# empiezan por RENDER_, que pone Render solo). Ejemplos posibles:
# ANTHROPIC_API_KEY=
# RIOT_API_KEY=
# RIOT_TORNEO_KEY=
# DISCORD_GUILD_ID=
# DISCORD_JEFE_ID=
# CANAL_TWITCH=
# CANAL_KICK=
